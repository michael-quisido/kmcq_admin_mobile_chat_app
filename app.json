{
  "expo": {
    "name": "kmcq_admin_mobile_chat_app",
    "slug": "kmcq-gmbh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/orangeBGkmcq-cloud-company-white-logoFinale.png",
    "scheme": "kmcqadminmobilechatapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.kmcq.adminmobilechatapp",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "networkSecurityConfig": "./android/app/src/main/res/xml/network_security_config.xml",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/kmcq-gmbh-android-icon-foreground-512x512.png",
        "backgroundImage": "./assets/images/android-kmcq-gmbh-512x512.png",
        "monochromeImage": "./assets/images/android-kmcq-gmbh-512x512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040f2d",
          "image": "./assets/images/kmcq-splash-touch-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "defaultChannel": "livechat",
          "sounds": ["./assets/notification_sound/kmcq_gmbh_doorbell.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "52a742b9-d63c-4bbb-9cd7-50bb0fcfa2b2"
      }
    },
    "owner": "kmcq-gmbh"
  }
}
